# Template only: no secrets. Use it to run the built release directly (node dist/standalone/app.cjs) with
# environment variables, for example in local testing. On the hosting account use settings.cjs instead:
# when settings.cjs exists, a differing YR_* environment value is rejected at startup.
#
# Real values belong in a private, untracked file. `.env*` is git-ignored except this template.
PORT=3000
YR_APP_ORIGIN=https://crm.yourrest.org
# 64+ hex characters: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
YR_AUTH_SECRET=
YR_DATABASE_PATH=/absolute/private/path/yourrest-crm-data/database.sqlite
YR_OBJECTS_PATH=/absolute/private/path/yourrest-crm-data/objects
YR_MAIL_TRANSPORT=sendmail
YR_MAIL_FROM=noreply@yourrest.org
YR_SENDMAIL_PATH=/usr/sbin/sendmail
# Optional National Address lookup key
YR_NATIONAL_ADDRESS_API_KEY=
